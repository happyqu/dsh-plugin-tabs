{
  "name": "dsh-plugin-tabs",
  "version": "0.1.0",
  "description": "Session tabs for DeepSeek Harness with tab switching, drag sorting, scrolling, and batch closing.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "tabs", "session-tabs"],
  "type": "module",
  "scripts": { "test": "node --test" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "assets/screenshot.png"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
